{
  "name": "api-rag-chatbot",
  "version": "1.0.0",
  "description": "Chatbot with RAG Architecture",
  "main": "src/server.ts",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "db:setup": "tsx src/db/setup.ts",
    "excel:generate": "tsx src/scripts/generate-excel.ts",
    "excel:read": "tsx src/scripts/read-excel.ts",
    "pdf:read": "tsx src/scripts/read-pdf.ts",
    "chunks": "tsx src/scripts/chunks.ts",
    "embeddings": "tsx src/scripts/embeddings.ts"
  },
  "keywords": [
    "RAG",
    "Chatbot"
  ],
  "author": "Jorge Luis Rodriguez",
  "dependencies": {
    "@chroma-core/default-embed": "^0.1.9",
    "cors": "^2.8.6",
    "dotenv": "^18.0.1",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "pdfkit": "^0.20.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "sharp": "^0.35.4"
  }
}
